ASPNETCORE_ENVIRONMENT=Development
Database__Schema=controle_financeiro

# SQLite local
ConnectionStrings__DefaultConnection=Data Source=financeiro.db

# Deploy EC2 com docker-compose.ec2.full.yml
EC2_CONNECTION_STRING=Data Source=/data/financeiro.db
EC2_DATABASE_SCHEMA=
EXPO_PUBLIC_API_URL=/api
API_PORT=8081
FRONTEND_PORT=80

Auth__Username=admin
Auth__Password=troque-esta-senha
Auth__JwtKey=troque-esta-chave-com-pelo-menos-32-caracteres
Auth__Issuer=MeuProjetoFinanceiro
Auth__Audience=MeuProjetoFinanceiro.App

# Supabase Postgres direto
# ConnectionStrings__DefaultConnection=Host=db.PROJECT.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=SUA_SENHA;SSL Mode=Require;Trust Server Certificate=true

# Supabase pooler, como no DBeaver/print
