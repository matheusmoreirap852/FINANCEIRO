@model IReadOnlyList<MeuProjetoFinanceiro.Application.Dtos.OrcamentoDto>
@{
    ViewData["Title"] = "Orcamentos";
}

<h1 class="h3 mb-3">Orcamentos</h1>
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Nome</th><th>Periodo</th><th>Categoria</th><th class="text-end">Planejado</th><th class="text-end">Realizado</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nome</td>
                    <td>@item.Mes/@item.Ano</td>
                    <td>@item.CategoriaNome</td>
                    <td class="text-end">@item.ValorPlanejado.ToString("C")</td>
                    <td class="text-end">@item.ValorRealizado.ToString("C")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
