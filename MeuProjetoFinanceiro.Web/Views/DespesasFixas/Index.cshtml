@model MeuProjetoFinanceiro.Application.Dtos.PlanejamentoDespesasFixasDto
@{
    ViewData["Title"] = "Despesas Fixas";
    var meses = Model.Meses.Select(m => m.Periodo).ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Despesas fixas</h1>
        <p class="text-muted mb-0">Prestacao, emprestimo, Uber, casa, jiu jitsu e outros compromissos mensais.</p>
    </div>
    <form method="get" class="d-flex gap-2">
        <input class="form-control" type="number" name="ano" value="@Model.Ano" style="width: 110px" />
        <button class="btn btn-outline-primary" type="submit">Ver ano</button>
    </form>
</div>

@if (TempData["Sucesso"] is not null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}
@if (TempData["Erro"] is not null)
{
    <div class="alert alert-danger">@TempData["Erro"]</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <span class="text-muted">Total no ano</span>
                <h2 class="h4 mb-0">@Model.TotalAno.ToString("C")</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <span class="text-muted">Media mensal</span>
                <h2 class="h4 mb-0">@Model.MediaMensal.ToString("C")</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <span class="text-muted">Maior mes</span>
                <h2 class="h4 mb-0">@Model.MaiorMes.ToString("C")</h2>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold">Lancar despesa fixa recorrente</div>
    <div class="card-body">
        <form asp-action="LancarRecorrente" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <div class="col-md-4">
                <label class="form-label">Descricao</label>
                <input class="form-control" name="Descricao" placeholder="Ex: Prestacao Casa" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Valor mensal</label>
                <input class="form-control" name="Valor" type="number" min="0" step="0.01" />
            </div>
            <div class="col-md-1">
                <label class="form-label">Mes inicial</label>
                <input class="form-control" name="MesInicial" type="number" min="1" max="12" value="@DateTime.Today.Month" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Ano inicial</label>
                <input class="form-control" name="AnoInicial" type="number" value="@Model.Ano" />
            </div>
            <div class="col-md-1">
                <label class="form-label">Mes final</label>
                <input class="form-control" name="MesFinal" type="number" min="1" max="12" value="12" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Ano final</label>
                <input class="form-control" name="AnoFinal" type="number" value="@Model.Ano" />
            </div>
            <div class="col-12">
                <button class="btn btn-primary" type="submit">Criar recorrencia</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold">Total por mes</div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Mes</th><th class="text-end">Total</th></tr></thead>
            <tbody>
            @foreach (var mes in Model.Meses)
            {
                <tr>
                    <td>@mes.Periodo</td>
                    <td class="text-end">@mes.Total.ToString("C")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold">Grade anual por despesa</div>
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Despesa</th>
                    @foreach (var mes in meses)
                    {
                        <th class="text-end">@mes</th>
                    }
                    <th class="text-end">Total</th>
                    <th class="text-end">Media</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var linha in Model.Linhas)
            {
                <tr>
                    <td class="fw-semibold">@linha.Nome</td>
                    @foreach (var valor in linha.Valores)
                    {
                        <td class="text-end">@(valor == 0 ? "-" : valor.ToString("C"))</td>
                    }
                    <td class="text-end">@linha.TotalAno.ToString("C")</td>
                    <td class="text-end">@linha.MediaMensal.ToString("C")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
