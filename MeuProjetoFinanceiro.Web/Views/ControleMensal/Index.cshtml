@model MeuProjetoFinanceiro.Application.Dtos.ControleMensalDto
@{
    ViewData["Title"] = "Controle Mensal";
    string GrupoClasse(string grupo) => grupo switch
    {
        "Entradas" => "table-success",
        "Despesas Fixas" => "table-info",
        "Cartao" => "table-warning",
        "Resumo" => "table-danger",
        _ => string.Empty
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Controle mensal</h1>
        <p class="text-muted mb-0">Entradas, despesas fixas, cartao, valor a pagar e saldo final em uma unica visao.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button class="btn btn-success" type="button" data-bs-toggle="modal" data-bs-target="#novaEntradaModal">+ Nova entrada</button>
        <form method="get" class="d-flex gap-2">
            <input class="form-control" type="number" name="ano" value="@Model.Ano" style="width: 110px" />
            <button class="btn btn-outline-primary" type="submit">Ver ano</button>
        </form>
    </div>
</div>

@if (TempData["Sucesso"] is not null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}
@if (TempData["Erro"] is not null)
{
    <div class="alert alert-danger">@TempData["Erro"]</div>
}

<div class="card border-0 shadow-sm module-card">
    <div class="card-header finance-card-header d-flex align-items-center justify-content-between">
        <span>Controle mensal</span>
        <button class="btn btn-light btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#novaEntradaModal">+ Nova entrada</button>
    </div>
    <form asp-action="Salvar" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Ano" value="@Model.Ano" />
        <div class="controle-mensal-toolbar d-flex flex-wrap align-items-center justify-content-between gap-2 p-3 border-bottom bg-white">
            <div class="btn-group btn-group-sm" role="group" aria-label="Navegacao da grade mensal">
                <button class="btn btn-outline-secondary" type="button" data-monthly-scroll="start">Inicio</button>
                <button class="btn btn-outline-secondary" type="button" data-monthly-scroll="left">Meses anteriores</button>
                <button class="btn btn-outline-secondary" type="button" data-monthly-scroll="right">Proximos meses</button>
                <button class="btn btn-outline-secondary" type="button" data-monthly-scroll="end">Fim</button>
            </div>
            <span class="text-muted small">Use a barra abaixo ou os botoes para navegar pelos meses.</span>
        </div>
        <div class="controle-mensal-scrollbar" data-monthly-scrollbar>
            <div class="controle-mensal-scrollbar-inner"></div>
        </div>
        <div class="table-responsive controle-mensal-scroll" data-monthly-table-scroll>
            <table class="table table-sm table-bordered align-middle mb-0 controle-mensal-table">
                <thead class="table-dark">
                    <tr>
                        <th class="sticky-col" style="min-width: 230px;">Descricao</th>
                        @foreach (var mes in Model.Meses)
                        {
                            <th class="text-end" style="min-width: 120px;">@mes</th>
                        }
                    </tr>
                </thead>
                <tbody>
                @{
                    var indice = 0;
                    string? grupoAtual = null;
                }
                @foreach (var linha in Model.Linhas)
                {
                    if (grupoAtual != linha.Grupo)
                    {
                        grupoAtual = linha.Grupo;
                        <tr class="@GrupoClasse(linha.Grupo)">
                            <th colspan="13">@linha.Grupo</th>
                        </tr>
                    }

                    <tr class="@(linha.Destaque ? GrupoClasse(linha.Grupo) : "")">
                        <td class="sticky-col @(linha.Destaque ? "fw-bold" : "")">
                            <div class="d-flex align-items-center justify-content-between gap-2">
                                <span>@linha.Nome</span>
                                @if (linha.PodeExcluir)
                                {
                                    <button class="btn btn-sm btn-outline-danger"
                                            type="submit"
                                            formaction="@Url.Action("RemoverEntrada", "ControleMensal", new { ano = Model.Ano, nome = linha.Nome })"
                                            formmethod="post"
                                            onclick="return confirm('Excluir esta entrada do ano inteiro?');">
                                        Excluir
                                    </button>
                                }
                            </div>
                        </td>
                        @for (var mes = 1; mes <= linha.Valores.Count; mes++)
                        {
                            var valor = linha.Valores[mes - 1];
                            var classeValor = valor < 0 ? "text-danger fw-bold" : linha.NegativoRuim && valor > 0 ? "text-danger fw-semibold" : "";
                            <td class="text-end @classeValor">
                                @if (linha.PodeEditar)
                                {
                                    <input type="hidden" name="Valores[@indice].Grupo" value="@linha.Grupo" />
                                    <input type="hidden" name="Valores[@indice].Nome" value="@linha.Nome" />
                                    <input type="hidden" name="Valores[@indice].Mes" value="@mes" />
                                    <input class="form-control form-control-sm text-end"
                                           name="Valores[@indice].Valor"
                                           type="number"
                                           min="0"
                                           step="0.01"
                                           value="@(valor?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) ?? "")" />
                                    indice++;
                                }
                                else
                                {
                                    @(valor.HasValue ? valor.Value.ToString("C") : "-")
                                }
                            </td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="controle-mensal-actions d-flex justify-content-end gap-2 p-3 border-top bg-light">
            <button class="btn btn-primary" type="submit">Salvar alteracoes</button>
        </div>
    </form>
</div>

<div class="modal fade" id="novaEntradaModal" tabindex="-1" aria-labelledby="novaEntradaModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="LancarEntrada" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header finance-card-header">
                    <h2 class="modal-title h5" id="novaEntradaModalLabel">Nova entrada</h2>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Descricao</label>
                        <input class="form-control" name="Descricao" placeholder="Ex: Salario, bonus, ferias" required />
                    </div>
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label class="form-label">Valor</label>
                            <input class="form-control" name="Valor" type="number" min="0" step="0.01" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Mes</label>
                            <input class="form-control" name="Mes" type="number" min="1" max="12" value="@DateTime.Today.Month" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Ano</label>
                            <input class="form-control" name="Ano" type="number" value="@Model.Ano" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">Cadastrar entrada</button>
                </div>
            </form>
        </div>
    </div>
</div>
