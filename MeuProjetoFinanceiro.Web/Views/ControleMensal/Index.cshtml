@model MeuProjetoFinanceiro.Application.Dtos.ControleMensalDto
@{
    ViewData["Title"] = "Controle Mensal";
    string GrupoClasse(string grupo) => grupo switch
    {
        "Entradas" => "table-success",
        "Despesas Fixas" => "table-info",
        "Cartao" => "table-warning",
        "Resumo" => "table-danger",
        _ => string.Empty
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Controle mensal</h1>
        <p class="text-muted mb-0">Entradas, despesas fixas, cartao, valor a pagar e saldo final em uma unica visao.</p>
    </div>
    <form method="get" class="d-flex gap-2">
        <input class="form-control" type="number" name="ano" value="@Model.Ano" style="width: 110px" />
        <button class="btn btn-outline-primary" type="submit">Ver ano</button>
    </form>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-sm table-bordered align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th style="min-width: 230px;">Descricao</th>
                    @foreach (var mes in Model.Meses)
                    {
                        <th class="text-end" style="min-width: 105px;">@mes</th>
                    }
                </tr>
            </thead>
            <tbody>
            @{
                string? grupoAtual = null;
            }
            @foreach (var linha in Model.Linhas)
            {
                if (grupoAtual != linha.Grupo)
                {
                    grupoAtual = linha.Grupo;
                    <tr class="@GrupoClasse(linha.Grupo)">
                        <th colspan="13">@linha.Grupo</th>
                    </tr>
                }

                <tr class="@(linha.Destaque ? GrupoClasse(linha.Grupo) : "")">
                    <td class="@(linha.Destaque ? "fw-bold" : "")">@linha.Nome</td>
                    @foreach (var valor in linha.Valores)
                    {
                        var classeValor = valor < 0 ? "text-danger fw-bold" : linha.NegativoRuim && valor > 0 ? "text-danger fw-semibold" : "";
                        <td class="text-end @classeValor">
                            @(valor.HasValue ? valor.Value.ToString("C") : "-")
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
