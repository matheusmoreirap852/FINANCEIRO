@model IReadOnlyList<MeuProjetoFinanceiro.Application.Dtos.CategoriaDto>
@{
    ViewData["Title"] = "Categorias";
}

<h1 class="h3 mb-3">Categorias</h1>
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Nome</th><th>Tipo</th><th>Cor</th><th>Status</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nome</td>
                    <td>@item.Tipo</td>
                    <td><span class="badge" style="background-color:@item.Cor">@item.Cor</span></td>
                    <td>@(item.Ativa ? "Ativa" : "Inativa")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
