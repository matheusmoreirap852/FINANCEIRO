<!DOCTYPE html>
<html lang="pt-br">
@{
    var controllerAtual = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    string Active(string controller) => controllerAtual.Equals(controller, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Meu Projeto Financeiro</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MeuProjetoFinanceiro.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="app-topbar">
        <div class="container-fluid d-flex align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-2">
                <button class="navbar-toggler app-menu-toggle d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#appSidebar" aria-controls="appSidebar"
                        aria-expanded="false" aria-label="Alternar navegacao">
                    <span class="app-menu-icon" aria-hidden="true">☰</span>
                    <span>Menu</span>
                </button>
                <a class="app-brand" asp-area="" asp-controller="Dashboard" asp-action="Index">Meu Financeiro</a>
            </div>
            <div class="app-user">
                <span>Ola, admin</span>
                <span class="app-user-badge">Admin</span>
            </div>
        </div>
    </header>

    <div class="app-shell">
        <aside id="appSidebar" class="app-sidebar collapse d-lg-flex">
            <div class="app-sidebar-title">Controle</div>
            <nav class="app-nav">
                <a class="@Active("Dashboard")" asp-area="" asp-controller="Dashboard" asp-action="Index">
                    <span class="app-nav-icon">D</span> Dashboard
                </a>
                <a class="@Active("ControleMensal")" asp-area="" asp-controller="ControleMensal" asp-action="Index">
                    <span class="app-nav-icon">C</span> Controle mensal
                </a>
                <a class="@Active("CartaoCredito")" asp-area="" asp-controller="CartaoCredito" asp-action="Index">
                    <span class="app-nav-icon">F</span> Cartao e entradas
                </a>
                <a class="@Active("DespesasFixas")" asp-area="" asp-controller="DespesasFixas" asp-action="Index">
                    <span class="app-nav-icon">P</span> Despesas fixas
                </a>
                <a class="@Active("Transacoes")" asp-area="" asp-controller="Transacoes" asp-action="Index">
                    <span class="app-nav-icon">T</span> Transacoes
                </a>
                <a class="@Active("Orcamentos")" asp-area="" asp-controller="Orcamentos" asp-action="Index">
                    <span class="app-nav-icon">O</span> Orcamentos
                </a>
                <a class="@Active("Contas")" asp-area="" asp-controller="Contas" asp-action="Index">
                    <span class="app-nav-icon">B</span> Contas
                </a>
                <a class="@Active("Categorias")" asp-area="" asp-controller="Categorias" asp-action="Index">
                    <span class="app-nav-icon">G</span> Categorias
                </a>
                <a class="@Active("Importacao")" asp-area="" asp-controller="Importacao" asp-action="Index">
                    <span class="app-nav-icon">I</span> Importacao
                </a>
            </nav>
        </aside>

        <main role="main" class="app-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
